+            (Some(a), Some(b)) if same_arc_array(&a.floors, &b.floors) => true,
+            (None, None) => false,
+            _ => return Ok(false),
+        };
+        // Future is already canonical text: compare its exact Option/string bytes
+        // rather than escaping a potentially multi-megabyte anchor twice. None
+        // and Some("") remain different. All other nullable fields stay serialized.
+        if self.state.future != other.state.future { return Ok(false); }
