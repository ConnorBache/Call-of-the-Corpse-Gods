+            actor.conditions.get(&format!("upkeepPaidAmount:{id}")).copied().unwrap_or(0.).max(0.)
+        } else {0.};
+        let due=(cost-prepaid).max(0.);if due==0. {continue;}
+        if crate::revision50::enabled(r) {
