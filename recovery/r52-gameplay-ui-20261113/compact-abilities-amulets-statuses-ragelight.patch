+        for(w,h)in[(1280,800),(1920,1080),(960,1200)] {
+            let mut p=crate::render::Painter::new();p.resize(w,h);p.set_responsive_canvas(true);
+            let count=capacity(&p.profile);
+            for i in 0..count {
